{
  "name": "ryugi-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ryugi-hub-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute ryugi-hub-db --remote --file=./schema.sql --yes",
    "sync": "bun run scripts/sync.ts",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "wrangler": "^4.167.0"
  }
}
